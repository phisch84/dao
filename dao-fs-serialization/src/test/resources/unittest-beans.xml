<beans 
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    
    xsi:schemaLocation="
    http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">
    
    <bean id="FileSystemDO" class="com.schoste.ddd.infrastructure.dao.v4.fs.FileSystemDO" scope="prototype" />
    <bean id="FileSystemDAO" class="com.schoste.ddd.infrastructure.dao.v4.fs.FileSystemDAOImpl" scope="singleton">
        <constructor-arg value="#{systemProperties['java.io.tmpdir']}/dao-fs-serialization/fs" />
    </bean>
    
    <bean id="SerializationDO" class="com.schoste.ddd.infrastructure.dao.v4.serialization.SerializationDO" scope="prototype" />
    <bean id="SerializationDAO" class="com.schoste.ddd.infrastructure.dao.v4.serialization.SerializationDAOImpl" scope="singleton">
        <constructor-arg value="#{systemProperties['java.io.tmpdir']}/dao-fs-serialization/ser" />
    </bean>
</beans>