<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.schoste.ddd.infrastructure</groupId>
        <artifactId>dao4-parent</artifactId>
        <version>4.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>dao4-hibernate</artifactId>
    <name>DAO 4 - Hibernate</name>

    <dependencies>
        <dependency>
            <groupId>com.schoste.ddd.infrastructure</groupId>
            <artifactId>dao4</artifactId>
        </dependency>

        <!-- Hibernate -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
        </dependency>

        <!-- Database drivers depend on the actual usage and therefore their scope is TEST -->
        <dependency>
            <groupId>commons-dbcp</groupId>
            <artifactId>commons-dbcp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.hsqldb</groupId>
            <artifactId>hsqldb</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>com.schoste.ddd.infrastructure</groupId>
            <artifactId>dao4</artifactId>
            <classifier>tests</classifier>
            <type>test-jar</type>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
            src/main/java, src/test/java and src/test/resources are shared with the module dao-h-jakarta (Hibernate 6.6 and later),
            so they must work with all Hibernate versions;
            src/main/java-hibernate5 holds what is specific to Hibernate 5.6 (HibernateVersionSupport, package-info)
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-hibernate5-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/main/java-hibernate5</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
