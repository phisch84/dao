<beans
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
    http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

    <!-- a second DAO of the same session factory: a transaction spans both -->
    <bean id="OtherHibernateDAO" class="com.schoste.ddd.infrastructure.dao.v4.hibernate.HibernateDAOImpl" scope="singleton" />

    <bean id="HibernateDAOTransactionManager" class="com.schoste.ddd.infrastructure.dao.v4.hibernate.HibernateDAOTransactionManager" scope="singleton">
        <constructor-arg ref="sessionFactory" />
    </bean>
</beans>
