<beans 
    xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:jdbc="http://www.springframework.org/schema/jdbc"

    xsi:schemaLocation="
    http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd
    http://www.springframework.org/schema/jdbc
    http://www.springframework.org/schema/jdbc/spring-jdbc-3.0.xsd">
	
    <!--
    The in-memory HSQL database of the tests (shared by dao-h and dao-h-jakarta). The tests use this data source to set up the
    database (db-setup.xml) and to check the stored rows directly, bypassing Hibernate.
    -->
    <bean id="hsqlTestDataSource" class="org.apache.commons.dbcp.BasicDataSource" destroy-method="close">
        <property name="driverClassName" value="org.hsqldb.jdbcDriver"/>
        <property name="url" value="jdbc:hsqldb:mem:daoh" />
        <property name="username" value="sa" />
        <property name="password" value="" />
    </bean>

    <!--
    The session factory of the DAOs, on the same database, built by the library's SessionFactoryBuilder.
    These settings and the mapping work with all supported Hibernate versions (5.6, 6.6, 7).
    -->

    <bean id="sessionFactory" class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
        <property name="targetClass" value="com.schoste.ddd.infrastructure.dao.v4.hibernate.SessionFactoryBuilder"/>
        <property name="targetMethod" value="buildSessionFactory"/>
        <property name="arguments">
            <list>
                <map>
                    <entry key="hibernate.connection.url" value="jdbc:hsqldb:mem:daoh" />
                    <entry key="hibernate.connection.driver_class" value="org.hsqldb.jdbcDriver" />
                    <entry key="hibernate.connection.username" value="sa" />
                    <entry key="hibernate.connection.password" value="" />
                    <entry key="hibernate.dialect" value="org.hibernate.dialect.HSQLDialect" />
                    <entry key="hibernate.show_sql" value="true" />
                </map>
                <list>
                    <value>META-INF/example-entities.xml</value>
                </list>
            </list>
        </property>
    </bean>
</beans>